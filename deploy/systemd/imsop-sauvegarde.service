[Unit]
Description=Sauvegarde IMSOP hors site (base + documents, chiffrée)
Documentation=file:///opt/imsop/docs/BACKUPS.md
# La sauvegarde entre dans les conteneurs : sans Docker, elle ne peut rien faire.
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=imsop
Group=imsop
WorkingDirectory=/opt/imsop
ExecStart=/opt/imsop/deploy/sauvegarde-hors-site.sh

# Une sauvegarde ne doit jamais peser sur le service qu'elle protège : elle
# s'efface devant l'application si la machine est chargée.
Nice=10
IOSchedulingClass=idle

# Un dépôt distant lent ou injoignable ne doit pas laisser le script tourner
# indéfiniment et chevaucher le passage du lendemain.
TimeoutStartSec=3h

# Un échec doit réclamer l'attention de quelqu'un.
#
# Les sauvegardes de cette plateforme ont échoué chaque nuit pendant des
# semaines sans que personne ne le sache : elles écrivaient dans un journal que
# rien n'obligeait à lire. Le dispositif a changé, pas cette propriété — une
# sauvegarde silencieuse ressemble exactement à une sauvegarde qui marche.
#
# Le délai d'attente ci-dessus compte comme un échec, donc un envoi qui part
# dans le vide déclenche l'alerte au même titre qu'une erreur de restic.
OnFailure=imsop-sauvegarde-alerte.service

[Install]
WantedBy=multi-user.target
