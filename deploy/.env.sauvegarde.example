# Sauvegarde hors site — modèle.
#
#   cp deploy/.env.sauvegarde.example deploy/.env.sauvegarde
#   chmod 600 deploy/.env.sauvegarde
#
# Le vrai fichier n'est JAMAIS versionné : il contient la phrase de passe qui
# déchiffre toutes les sauvegardes, et les clés du dépôt distant.

# --- Où partent les sauvegardes ----------------------------------------------
# Un dépôt restic. Quelques formes possibles :
#
#   s3:s3.eu-central-003.backblazeb2.com/imsop-sauvegardes   (Backblaze B2)
#   s3:s3.fr-par.scw.cloud/imsop-sauvegardes                 (Scaleway)
#   s3:<id>.r2.cloudflarestorage.com/imsop-sauvegardes       (Cloudflare R2)
#   sftp:imsop@autre-machine:/srv/sauvegardes/imsop          (une autre machine)
#
# Le seul critère qui compte : ce ne doit pas être le même disque, ni le même
# hébergeur, que le serveur de production. Une sauvegarde qui disparaît avec la
# machine qu'elle sauvegarde n'en est pas une.
RESTIC_REPOSITORY=

# --- Ce qui déchiffre les sauvegardes ----------------------------------------
# restic chiffre côté client : l'hébergeur distant ne voit que des blocs
# opaques. C'est ce qui autorise des documents médicaux à quitter la machine.
#
# SANS CETTE PHRASE, AUCUNE RESTAURATION N'EST POSSIBLE. Personne ne peut la
# régénérer, pas même l'hébergeur. Gardez-en une copie hors de ce serveur — un
# gestionnaire de mots de passe, ou du papier dans un endroit sûr.
#
# Pour en générer une : openssl rand -base64 48
RESTIC_PASSWORD=

# --- Accès au dépôt distant (pour les dépôts S3) ------------------------------
# Des clés dédiées à ce bucket, en écriture seulement si le fournisseur le
# permet. Ce ne sont PAS les clés de Garage, qui est le stockage local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Rétention ----------------------------------------------------------------
# Combien de points de restauration garder. Les valeurs par défaut gardent de
# quoi remonter à un an, sans que le dépôt grossisse indéfiniment.
SAUVEGARDE_GARDE_QUOTIDIEN=14
SAUVEGARDE_GARDE_HEBDO=8
SAUVEGARDE_GARDE_MENSUEL=12
