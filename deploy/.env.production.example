# =============================================================================
# IMSOP — variables de production.
#
# Copier en `deploy/.env.production`, remplir, puis NE JAMAIS le committer :
# ce fichier contient les clés de paiement, le mot de passe SMTP et les secrets
# de session. Sur le serveur : chmod 600 deploy/.env.production
#
# Les lignes marquées ⚠ doivent impérativement être changées avant l'ouverture
# au public. Celles marquées ◻ peuvent rester telles quelles au démarrage.
# =============================================================================

NODE_ENV=production
PORT=4000

# --- Adresses publiques ------------------------------------------------------
# ⚠ Le domaine du site, sans barre oblique finale. PUBLIC_URL sert aux liens
# écrits dans les courriels (identifiants d'un praticien recruté, formulaires de
# candidature) : tant qu'il vaut localhost, ces liens ne mènent nulle part.
PUBLIC_URL=https://imsop.example.org
CORS_ORIGIN=https://imsop.example.org
BACKEND_BASE_URL=https://imsop.example.org

# nginx est en frontal sur la boucle locale et réécrit X-Forwarded-For avec l'IP
# réelle. `loopback` dit à Express de ne faire confiance qu'à lui : c'est ce qui
# empêche un client de remettre à zéro son compteur de limitation de débit en
# forgeant cet en-tête.
TRUST_PROXY=loopback

# --- Base de données ---------------------------------------------------------
# ⚠ Un mot de passe long et unique. PostgreSQL n'est pas exposé hors du réseau
# Docker, mais ce mot de passe protège aussi les sauvegardes.
POSTGRES_USER=imsop
POSTGRES_PASSWORD=
POSTGRES_DB=imsop
# DATABASE_URL est composée par docker-compose : ne pas la définir ici.

# --- Secrets de session ------------------------------------------------------
# ⚠ 48 octets aléatoires chacun, DIFFÉRENTS l'un de l'autre. Le serveur refuse
# de démarrer en production si l'un d'eux fait moins de 32 caractères.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Stockage des documents --------------------------------------------------
# ⚠ Stockage objet compatible S3, chez un fournisseur. Les documents médicaux
# n'habitent donc pas le disque du VPS : sa perte ne les emporte pas, et la
# copie hors-site est acquise sans rien faire de plus.
#
# Scaleway (Paris, données en France — le plus sûr pour des données de santé) :
#   S3_ENDPOINT=https://s3.fr-par.scw.cloud
#   S3_REGION=fr-par
#
# Cloudflare R2 (10 Go gratuits, pas de frais de sortie) :
#   S3_ENDPOINT=https://<identifiant-de-compte>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=imsop
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Style « chemin » : l'adresse du bucket est /imsop/... plutôt qu'un
# sous-domaine. Accepté par Scaleway comme par R2, et évite les surprises de
# certificat sur les noms de bucket.
S3_FORCE_PATH_STYLE=true

# --- Courriel ----------------------------------------------------------------
# ⚠ Sans SMTP fonctionnel, aucun code 2FA ne part : plus personne ne se connecte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=IMSOP <no-reply@imsop.example.org>

# ⚠ Le comité scientifique n'a pas de compte : chaque candidature lui part par
# courriel, photo et CV joints. Sans cette ligne, il ne reçoit rien.
COMITE_EMAILS=

# --- SMS (facultatif) --------------------------------------------------------
# ◻ Laisser vide désactive le canal SMS ; les notifications restent par e-mail.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=IMSOP
SMS_DEFAULT_COUNTRY_CODE=237

# --- Paiements ---------------------------------------------------------------
# ⚠ Clés de production, pas celles de test.
FAPSHI_ENV=live
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
FAPSHI_REDIRECT_URL=https://imsop.example.org/patient/matching
# Décaissements vers les spécialistes : clés distinctes chez Fapshi.
FAPSHI_PAYOUT_API_USER=
FAPSHI_PAYOUT_API_KEY=

CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=https://imsop.example.org/api/paiements/webhook
CINETPAY_RETURN_URL=https://imsop.example.org/patient/matching

# --- Connexion Google (facultatif) -------------------------------------------
# ◻ Les URI de redirection autorisées doivent pointer sur le domaine ci-dessus.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Règles métier -----------------------------------------------------------
# ◻ Tarifs d'un second avis, en XAF, par niveau d'urgence.
TARIF_STANDARD_XAF=115000
TARIF_PRIORITAIRE_XAF=165000
TARIF_URGENT_XAF=230000
# ◻ Mise en relation « Trouver un médecin ».
TARIF_ANNUAIRE_XAF=3000

# ⚠ Part que la plateforme retient sur chaque avis, en pourcent. La valeur
# ci-dessous est celle par défaut du code — à arbitrer avant l'ouverture, c'est
# elle qui décide de ce qui revient au spécialiste.
COMMISSION_PLATEFORME_POURCENT=30

# ◻ Taux de change depuis l'euro, pour les spécialistes hors zone franc. Le XAF
# est à parité fixe avec l'euro (1 € = 655,957 XAF) et n'a donc pas de ligne ici.
TAUX_EUR_USD=1.08
TAUX_EUR_GBP=0.85
TAUX_EUR_CHF=0.95
TAUX_EUR_MAD=10.8
TAUX_EUR_DZD=145
TAUX_EUR_TND=3.3

# ◻ Délai de réponse attendu, et seuil d'alerte de la coordination.
DELAI_REPONSE_HEURES=48
DELAI_ALERTE_HEURES=24
# ◻ Fermeture automatique du fil de messagerie d'un dossier.
MESSAGING_AUTO_CLOSE_DAYS=14
# ◻ Pays ouverts à l'annuaire de proximité (codes CEMAC, séparés par des virgules).
ANNUAIRE_PAYS_OUVERTS=cm
