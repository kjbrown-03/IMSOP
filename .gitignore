node_modules/
dist/
.env
.env.local
backend/.env
backend/uploads/
# Contains raw database dumps and copies of uploaded medical documents -
# must never be committed, on this machine or any other clone of the repo.
backend/backups/
backend/node_modules/
backend/dist/
*.log
.DS_Store

# Claude Code (local runtime state)
.claude/scheduled_tasks.lock

# Configuration de production : clés de paiement, mot de passe SMTP, secrets de
# session. L'exemple versionné (deploy/.env.production.example) suffit à savoir
# quoi remplir.
deploy/.env.production
deploy/backups/

# Sauvegarde hors site : contient la phrase de passe qui déchiffre TOUTES les
# sauvegardes. Publiée, elle rendrait le chiffrement inutile et exposerait
# l'intégralité des dossiers médicaux conservés chez l'hébergeur distant.
deploy/.env.sauvegarde

# Clés SSH et certificats. Une clé privée generee par megarde dans le dossier
# du projet partirait au premier `git add .` — et une cle publiee est une cle
# perdue.
id_ed25519*
id_rsa*
*.pem
*.key

# Configuration coturn remplie : contient le secret partage avec le backend,
# qui vaut acces au relais. Le modele versionne est turnserver.conf.example.
deploy/coturn/turnserver.conf
