# Environnement des tests automatisés — chargé par tests/setup.js.
#
# Aucune valeur réelle ici : ce fichier est versionné pour que la suite soit
# reproductible sur n'importe quelle machine. Les secrets de production vivent
# dans backend/.env, qui est hors dépôt.

NODE_ENV=test
PORT=4001

# Base DÉDIÉE aux tests. Elle est vidée entre chaque test : ne jamais pointer
# cette variable sur la base de développement, encore moins sur la production.
DATABASE_URL="postgresql://imsop:imsop@localhost:5432/imsop_test?schema=public"

# Longs uniquement pour satisfaire la validation de config/env.js (>= 32 car.).
JWT_ACCESS_SECRET=test-access-secret-non-sensible-0000000000
JWT_REFRESH_SECRET=test-refresh-secret-non-sensible-000000000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# MinIO n'est pas nécessaire : les tests ne montent aucun fichier. Les valeurs
# servent juste à ce que le client S3 s'instancie sans erreur.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=imsop-test
S3_FORCE_PATH_STYLE=true

# SMTP_USER volontairement vide : le mailer bascule alors en mode journal et
# n'ouvre aucune connexion réseau (voir src/lib/mailer.js).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="IMSOP tests <no-reply@imsop.test>"

MESSAGING_AUTO_CLOSE_DAYS=14

BACKEND_BASE_URL=http://localhost:4001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
