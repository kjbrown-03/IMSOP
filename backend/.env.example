# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Adresse d'ecoute. Laisser vide en dev (0.0.0.0, pour tester au telephone).
# En PROD derriere nginx : HOST=127.0.0.1 pour que le backend ne soit joignable
# que par nginx, jamais en direct depuis Internet ou le LAN.
# HOST=127.0.0.1

# Confiance accordee au X-Forwarded-For (IP reelle pour le rate-limit / logs).
# Laisser vide en dev (= false, aucun proxy : impossible d'usurper l'en-tete).
# En PROD derriere nginx sur le meme hote : TRUST_PROXY=loopback.
# (nombre de sauts, 'loopback', ou liste d'IP/sous-reseaux acceptes aussi.)
# TRUST_PROXY=loopback

# Database
# In production, running under PM2 cluster mode (see ecosystem.config.js) means
# EACH worker process opens its own Prisma connection pool (default size =
# CPU cores * 2 + 1). With 8 workers that alone can exceed Postgres's default
# max_connections (100) before a single real request arrives. Cap it per
# worker with connection_limit, sized so (workers * connection_limit) stays
# safely under the database's max_connections - e.g. 5 here for 8 workers
# leaves headroom for migrations, admin tools, etc.
DATABASE_URL="postgresql://imsop:imsop@localhost:5432/imsop?schema=public&connection_limit=5"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# S3 / MinIO (documents storage, kept separate from metadata in Postgres)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=imsop-documents
S3_FORCE_PATH_STYLE=true

# CinetPay
CINETPAY_API_KEY=change-me
CINETPAY_SITE_ID=change-me
CINETPAY_SECRET_KEY=change-me
CINETPAY_NOTIFY_URL=http://localhost:4000/api/paiements/webhook
CINETPAY_RETURN_URL=http://localhost:5173/patient/matching

# Comite scientifique (personnes physiques, sans compte). Chaque candidature
# remplie leur est envoyee par e-mail avec la photo jointe. Plusieurs adresses
# separees par des virgules.
COMITE_EMAILS=comite@imsop.org

# Tarifs d'un second avis, en XAF, par niveau d'urgence (CDC §40). Valeurs
# par defaut : 175 / 250 / 350 EUR convertis au taux fixe du franc CFA.
TARIF_STANDARD_XAF=115000
TARIF_PRIORITAIRE_XAF=165000
TARIF_URGENT_XAF=230000
# "Trouver un medecin" : commission de mise en relation entre le patient et
# les medecins verifies de sa zone, entierement conservee par la plateforme.
# 2000 est un point de depart a fixer, pas un prix decide.
TARIF_ANNUAIRE_XAF=2000

# Modele economique : commission retenue par la plateforme sur chaque
# transaction, le reste revient au specialiste dans sa devise.
COMMISSION_PLATEFORME_POURCENT=30
# Taux de change pour 1 euro (le franc CFA est fixe a 655,957 et n'a pas besoin
# d'etre ici). A tenir a jour a la main : aucune source de cours n'est branchee.
TAUX_EUR_CHF=0.94
TAUX_EUR_GBP=0.85
TAUX_EUR_USD=1.08

# Fapshi (Mobile Money MTN/Orange, Cameroun) - second fournisseur, a cote de
# CinetPay. Les patients dont le compte est au Cameroun passent par Fapshi ;
# sans FAPSHI_API_USER/KEY tout le monde reste sur CinetPay.
# Les acces s'obtiennent sur https://dashboard.fapshi.com (sandbox puis live).
# FAPSHI_API_USER=change-me
# FAPSHI_API_KEY=change-me
# Secret saisi dans le tableau de bord Fapshi, verifie sur chaque webhook.
# FAPSHI_WEBHOOK_SECRET=change-me
FAPSHI_ENV=sandbox
# URL de retour apres paiement (par defaut : celle de CinetPay).
# FAPSHI_REDIRECT_URL=http://localhost:5173/patient/matching
# URL de webhook a declarer chez Fapshi : <backend>/api/paiements/webhook/fapshi
# Decaissement (reversement des honoraires en Mobile Money). ACCES DISTINCTS :
# chez Fapshi, un service qui decaisse ne peut plus encaisser. Creer un second
# service, le faire activer en "payout" par leur support, et mettre ses cles ici.
# FAPSHI_PAYOUT_API_USER=change-me
# FAPSHI_PAYOUT_API_KEY=change-me

# Email (SMTP relay - works with SendGrid or Resend SMTP credentials too)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
MAIL_FROM="IMSOP <no-reply@imsop.org>"

# SMS (optionnel - sans SMS_API_URL le canal reste inactif et seuls l'e-mail
# et la cloche fonctionnent). L'URL recoit un POST JSON {to, from, message},
# ce qui convient a la plupart des agregateurs. Twilio couvre mal l'Afrique
# centrale : privilegier une passerelle locale (Orange, MTN, agregateur).
# SMS_API_URL=https://passerelle.example.com/v1/messages
# SMS_API_TOKEN=change-me
SMS_SENDER=IMSOP
# Indicatif applique aux numeros saisis en format local (237 = Cameroun).
SMS_DEFAULT_COUNTRY_CODE=237

# Engagement de delai de reponse. Le compte a rebours demarre a l'affectation
# du specialiste et s'arrete quand le rapport devient lisible par le demandeur.
DELAI_REPONSE_HEURES=48
# Mi-parcours : alerte envoyee a la coordination, une seule fois par dossier.
DELAI_ALERTE_HEURES=24

# Messaging
MESSAGING_AUTO_CLOSE_DAYS=14

# OAuth "Sign in with Google" (optional - the button stays usable without
# these, it just redirects to an explanatory error instead of Google).
# BACKEND_BASE_URL must be a URL Google can reach, and its
# /api/auth/oauth/google/callback must be registered as an authorized
# redirect URI in the OAuth client's settings:
#   https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
BACKEND_BASE_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed (dev only) - password for the test accounts created by `npm run db:seed`.
# Leave unset to get a random password printed to the console instead.
SEED_PASSWORD=ChangeMe123!

# Backups (optional - both have sensible defaults, see docs/BACKUPS.md)
# BACKUP_DIR=C:\backups\imsop
# BACKUP_RETENTION_DAYS=14

# Adresse publique du site, utilisee dans les courriels (liens de connexion).
# En production : https://votre-domaine. A defaut, CORS_ORIGIN est utilise.
PUBLIC_URL=http://localhost:5173

# --- Passage de Fapshi en argent reel ---
# 1. FAPSHI_ENV=live
# 2. Remplacer FAPSHI_API_USER / FAPSHI_API_KEY par les acces LIVE (ceux du
#    sandbox ne fonctionnent pas en live, ce sont deux services distincts).
# 3. FAPSHI_WEBHOOK_SECRET est OBLIGATOIRE en live : sans lui tous les webhooks
#    sont rejetes et aucun paiement n'est confirme. Le backend refuse de
#    demarrer s'il manque.
# 4. FAPSHI_REDIRECT_URL doit etre l'URL PUBLIQUE du site (ni localhost, ni
#    ngrok) : le backend refuse aussi de demarrer sinon.
# 5. Declarer l'URL de webhook dans le tableau de bord Fapshi :
#    https://<domaine-public>/api/paiements/webhook/fapshi
# 6. TARIF_ANNUAIRE_XAF : prix de la mise en relation, fixe a 2000 XAF.
#    Modifiable sans redeploiement. Minimum accepte par Fapshi : 100 XAF.

# Pays ou la mise en relation est vendable, separes par des virgules. Un pays
# ne doit y figurer QUE si un fournisseur de paiement y fonctionne : sinon le
# patient va jusqu'au bout du parcours pour echouer au paiement. Fapshi ne
# couvre que le Cameroun, d'ou la valeur par defaut.
ANNUAIRE_PAYS_OUVERTS=cm
