generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  SPECIALISTE
  // Médecin traitant du patient, dans son pays. Il accompagne le parcours et
  // n'intervient jamais à la place du spécialiste international : il dépose des
  // pièces, échange dans la messagerie et lit le rapport final.
  MEDECIN_LOCAL
  COORDINATEUR
  ADMIN
}

// Un témoignage publié sur le site public engage l'image de personnes réelles
// et peut toucher à des données de santé - jamais de publication automatique.
enum TemoignageStatut {
  EN_ATTENTE
  PUBLIE
  REJETE
}

enum DossierStatus {
  BROUILLON
  SOUMIS
  EN_ATTENTE_PAIEMENT
  EN_ATTENTE_DOCUMENTS
  EN_VERIFICATION
  COMPLET
  EN_ATTENTE_AFFECTATION
  AFFECTE
  ACCEPTE_PAR_SPECIALISTE
  EN_ANALYSE
  INFORMATION_COMPLEMENTAIRE_DEMANDEE
  RAPPORT_EN_PREPARATION
  RAPPORT_SOUMIS
  RAPPORT_VALIDE
  RAPPORT_TRANSMIS
  SUIVI
  CLOTURE
  ANNULE
  REFUSE
}

enum Urgence {
  NORMAL
  PRIORITAIRE
  URGENT
}

enum DocumentCategorie {
  ANALYSE_BIOLOGIQUE
  IMAGERIE
  ORDONNANCE
  COMPTE_RENDU
  // Pièce déposée dans la messagerie sécurisée plutôt que dans le tunnel de demande.
  MESSAGERIE
  // Généré automatiquement par le serveur quand le patient (ou le médecin
  // traitant demandeur) accepte et signe électroniquement - jamais téléversé
  // manuellement par un utilisateur.
  CONSENTEMENT
  AUTRE
}

enum VerificationStatus {
  EN_VERIFICATION
  VALIDE
  SUSPENDU
  EXPIRE
  REVOQUE
}

enum ProfessionalDocumentType {
  DIPLOME
  LICENCE
  INSCRIPTION_ORDRE
  PIECE_IDENTITE
  CV
  REFERENCES
  AUTRE
}

enum ConsentementType {
  TRAITEMENT_DONNEES
  TRANSMISSION_SPECIALISTE
  TELECONSULTATION
  COMMUNICATION_MEDECIN
  UTILISATION_ANONYMISEE_RECHERCHE
}

enum PaiementStatus {
  EN_ATTENTE
  PAYE
  ECHOUE
  REMBOURSE
}

enum HonoraireStatut {
  A_REVERSER
  EN_COURS
  REVERSE
  ECHOUE
}

enum RapportStatus {
  BROUILLON
  SOUMIS
  VALIDE
}

enum CandidatureType {
  SPECIALISTE
  MEDECIN_LOCAL
}

// Nature du lieu d'exercice d'un medecin traitant. Beaucoup exercent des deux
// cotes a la fois : une garde a l'hopital public et des consultations en
// clinique privee. LES_DEUX evite de les forcer a en taire un.
enum TypeStructure {
  CLINIQUE
  HOPITAL
  LES_DEUX
}

// Parcours de recrutement (comité scientifique) :
//   EN_ATTENTE -> ACCEPTEE -> COMPTE_CREE
//              -> REFUSEE
// ACCEPTEE et COMPTE_CREE sont distincts : le comité accepte, la coordination
// crée le compte ensuite. Entre les deux, la candidature attend dans la file
// de la coordination.
enum CandidatureStatut {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  COMPTE_CREE
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  role             Role
  fullName         String
  phone            String?
  avatarUrl        String?
  twoFactorEnabled Boolean  @default(false)
  emailVerified    Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient      Patient?
  specialiste  Specialiste?
  medecinLocal MedecinLocal?

  refreshTokens         RefreshToken[]
  twoFactorChallenges   TwoFactorChallenge[]
  passwordResetTokens   PasswordResetToken[]
  documentsUploaded     Document[]             @relation("DocumentUploadedBy")
  professionalDocuments ProfessionalDocument[]
  messagesSent          Message[]              @relation("MessageSender")
  conversationsA        Conversation[]         @relation("ConversationA")
  conversationsB        Conversation[]         @relation("ConversationB")
  auditLogs             AuditLog[]
  notifications         Notification[]
  temoignages           Temoignage[]           @relation("TemoignageAuteur")
  temoignagesModeres    Temoignage[]           @relation("TemoignageModerateur")
  recherchesAnnuaire    RechercheAnnuaire[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TwoFactorChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String    @default("LOGIN_2FA")
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  // Compteur d'essais : sans lui, seul le limiteur par IP protege le code a
  // 6 chiffres, ce qu'un attaquant reparti sur plusieurs adresses contourne.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Patient {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientRef            String    @unique
  dob                   DateTime?
  gender                String?
  nationality           String?
  country               String?
  city                  String?
  preferredLanguage     String?
  emergencyContactName  String?
  emergencyContactPhone String?

  identityDocumentKey    String?
  identityVerified       Boolean   @default(false)
  identityVerifiedAt     DateTime?
  identityRejectedReason String?
  identityReviewedById   String?

  createdAt DateTime @default(now())

  dossiers Dossier[]
}

model Specialiste {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialite    String
  pays          String?
  etablissement String?
  langues       String?
  bio           String?
  disponible    Boolean  @default(true)
  createdAt     DateTime @default(now())

  verificationStatus   VerificationStatus @default(EN_VERIFICATION)
  // Renseigne quand un coordinateur refuse, suspend ou revoque l'habilitation.
  verificationMotif    String?
  verifiedAt           DateTime?
  verifiedById         String?
  // Une licence d'exercice a une date de fin : au-dela, le compte passe EXPIRE.
  habilitationExpireLe DateTime?

  dossiers    Dossier[]
  rapports    Rapport[]
  recusations RecusationSpecialiste[]
  honoraires  Honoraire[]
}

model MedecinLocal {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialite    String?
  etablissement String?
  pays          String?
  // Ville de résidence, saisie depuis une liste fermée à l'inscription (voir
  // villesCameroun.js) :
  // un champ libre ferait compter « Douala », « douala » et « Douala 3e » pour
  // trois villes distinctes, et rendrait faux tout classement par ville.
  ville         String?
  // Numéro d'inscription à l'ordre des médecins du pays d'exercice. Vérifié
  // manuellement par un coordinateur avant que le compte puisse être rattaché
  // à un dossier.
  numeroOrdre   String?
  createdAt     DateTime @default(now())

  verificationStatus   VerificationStatus @default(EN_VERIFICATION)
  // Renseigne quand un coordinateur refuse, suspend ou revoque l'habilitation.
  verificationMotif    String?
  verifiedAt           DateTime?
  verifiedById         String?
  // Une licence d'exercice a une date de fin : au-dela, le compte passe EXPIRE.
  habilitationExpireLe DateTime?

  // --- Annuaire « Trouver un médecin » (zone CEMAC) ---------------------------
  // Un médecin traitant s'inscrit d'abord pour suivre SES patients. Apparaître
  // dans un service de mise en relation payant, où des patients lui seront
  // reliés, est un autre engagement :
  // il doit le demander explicitement. Désactivé par défaut, toujours.
  annuaireVisible      Boolean  @default(false)
  // Spécialités déclarées pour l'annuaire, depuis une liste fermée (voir
  // specialitesLocales.js) - un médecin en couvre souvent plusieurs (médecine
  // générale + pédiatrie). Distinct du champ libre `specialite` ci-dessus, qui
  // reste ce qu'il est.
  annuaireSpecialites  String[] @default([])
  // Quartier, après pays et ville : « Cameroun · Douala · Logpom ». C'est le
  // niveau où un patient décide s'il peut s'y rendre.
  quartier             String?
  // Quelques lignes de présentation, visibles sur la fiche une fois débloquée.
  annuairePresentation String?

  // Dossiers ou ce medecin a ete designe medecin traitant par le patient.
  dossiers          Dossier[]                   @relation("DossierMedecinTraitant")
  // Dossiers qu'il a lui-meme ouverts pour obtenir un second avis.
  demandes          Dossier[]                   @relation("DossierDemandeur")
  // Apparitions dans des recherches d'annuaire.
  resultatsAnnuaire RechercheAnnuaireResultat[]
}

enum RechercheAnnuaireStatut {
  // Résultats comptés et affichés floutés ; contacts masqués.
  FLOUTEE
  // Paiement confirmé : contacts visibles pour cette recherche uniquement.
  DEBLOQUEE
}

// Une recherche « Trouver un médecin ». Les médecins trouvés sont FIGÉS dans
// RechercheAnnuaireResultat au moment de la recherche : le paiement débloque
// exactement ce qui a été montré flouté - pas une nouvelle requête qui
// pourrait rendre plus, moins, ou d'autres médecins.
model RechercheAnnuaire {
  id           String                  @id @default(uuid())
  // Aucun compte n'est requis pour être mis en relation : la recherche est
  // accessible par son identifiant (non devinable). Si la personne est
  // connectée, la recherche lui est rattachée et devient privée ; sinon elle
  // reste ouverte à qui en a le lien - c'est le prix de l'absence de compte.
  userId       String?
  user         User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  // E-mail donné au moment de payer : exigé par les fournisseurs de paiement
  // pour créer la transaction, et seul moyen de savoir qui a été mis en
  // relation quand il n'y a pas de compte.
  emailContact String?
  symptomes    String
  // Spécialités déduites des symptômes (clés de specialitesLocales.js).
  specialites  String[]                @default([])
  pays         String
  ville        String?
  // Drapeau rouge détecté dans les symptômes : la recherche est enregistrée
  // mais aucune vente n'est proposée, on oriente vers les urgences (§29).
  urgence      Boolean                 @default(false)
  statut       RechercheAnnuaireStatut @default(FLOUTEE)
  debloqueeLe  DateTime?
  createdAt    DateTime                @default(now())

  resultats RechercheAnnuaireResultat[]
  paiements Paiement[]

  @@index([userId])
  @@index([createdAt])
}

model RechercheAnnuaireResultat {
  id          String            @id @default(uuid())
  rechercheId String
  recherche   RechercheAnnuaire @relation(fields: [rechercheId], references: [id], onDelete: Cascade)
  medecinId   String
  medecin     MedecinLocal      @relation(fields: [medecinId], references: [id], onDelete: Cascade)
  // Pertinence au moment de la recherche, pour l'ordre d'affichage.
  score       Int               @default(0)

  @@unique([rechercheId, medecinId])
}

model Dossier {
  id        String @id @default(uuid())
  reference String @unique

  // Optionnel depuis l'ouverture du parcours medecin : quand un medecin
  // traitant demande un second avis sur son propre diagnostic, il decrit un
  // patient anonymise (age, sexe) sans qu'aucun compte patient n'existe.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  // Le medecin a l'origine de la demande. Distinct de `medecinLocal`, qui est
  // le medecin traitant DESIGNE PAR LE PATIENT dans le parcours patient : les
  // deux roles ne se confondent pas et peuvent coexister.
  demandeurMedecinId String?
  demandeurMedecin   MedecinLocal? @relation("DossierDemandeur", fields: [demandeurMedecinId], references: [id])

  // Renseignes uniquement dans le parcours medecin. Volontairement non
  // nominatifs : aucune donnee identifiante sans consentement du patient.
  patientAge    Int?
  patientSexe   String?
  specialisteId String?
  specialiste   Specialiste? @relation(fields: [specialisteId], references: [id])

  // Désigné par le patient lui-même (consentement COMMUNICATION_MEDECIN), pas
  // par le coordinateur : c'est son médecin traitant, il le choisit.
  medecinLocalId String?
  medecinLocal   MedecinLocal? @relation("DossierMedecinTraitant", fields: [medecinLocalId], references: [id])

  specialiteRequise String
  motif             String
  questionMedicale  String?
  symptomes         String?
  antecedents       String?
  allergies         String?
  traitementEnCours String?
  urgence           Urgence       @default(NORMAL)
  status            DossierStatus @default(BROUILLON)

  assignedAt           DateTime?
  // Horodatage de l'alerte de mi-parcours (24 h). Sans lui, la tâche horaire
  // renverrait la même alerte à chaque passage tant que le dossier reste
  // ouvert - la coordination cesserait de les lire en deux jours.
  alerteDelaiEnvoyeeLe DateTime?
  messagingClosesAt    DateTime?

  // Le médecin traitant n'a pas de messagerie libre avec le spécialiste : il
  // pose une seule question au moment où il transmet le dossier à la
  // coordination, qui l'affecte ensuite avec le reste du dossier. Une fois
  // posée, elle ne peut plus être modifiée ni reposée sur ce dossier.
  questionMedecinLocal        String?
  questionMedecinLocalPoseeLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]
  consentements Consentement[]
  recusations   RecusationSpecialiste[]
  paiements     Paiement[]
  honoraires    Honoraire[]
  messages      Message[]
  rapport       Rapport?
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([patientId])
  @@index([specialisteId])
  @@index([medecinLocalId])
  @@index([demandeurMedecinId])
  @@index([status])
}

model Document {
  id           String            @id @default(uuid())
  dossierId    String
  dossier      Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User              @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  category     DocumentCategorie @default(AUTRE)
  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime          @default(now())

  messages Message[]

  @@index([dossierId])
}

model Consentement {
  id            String           @id @default(uuid())
  dossierId     String?
  dossier       Dossier?         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  // Nullable : une demande ouverte par un médecin traitant décrit un patient
  // anonymisé, sans compte - donc sans patientId. Le consentement y est alors
  // donné par le médecin traitant demandeur lui-même (voir nomSignataire).
  patientId     String?
  type          ConsentementType
  version       String           @default("1.0")
  accepted      Boolean
  // Nom complet tapé par le signataire pour la signature électronique du
  // formulaire de consentement (§ transmission au spécialiste) - absent pour
  // les autres types de consentement, qui restent de simples cases à cocher.
  nomSignataire String?
  ipAddress     String?
  acceptedAt    DateTime         @default(now())
  revokedAt     DateTime?

  @@index([dossierId])
  @@index([patientId])
}

model Paiement {
  id                    String             @id @default(uuid())
  // Un paiement règle SOIT un dossier de second avis, SOIT le déblocage d'une
  // recherche d'annuaire - jamais les deux, jamais aucun. Les deux clés sont
  // optionnelles ; c'est le contrôleur qui garantit qu'exactement une est
  // renseignée (voir paiements.controller.js).
  dossierId             String?
  dossier               Dossier?           @relation(fields: [dossierId], references: [id])
  rechercheAnnuaireId   String?
  rechercheAnnuaire     RechercheAnnuaire? @relation(fields: [rechercheAnnuaireId], references: [id])
  provider              String             @default("CINETPAY")
  amount                Decimal            @db.Decimal(10, 2)
  currency              String             @default("XAF")
  status                PaiementStatus     @default(EN_ATTENTE)
  cinetpayTransactionId String?            @unique
  // Fapshi génère lui-même son identifiant à la création du lien, là où
  // CinetPay reçoit le nôtre : d'où deux colonnes, chacune unique.
  fapshiTransId         String?            @unique
  rawWebhookPayload     Json?
  createdAt             DateTime           @default(now())
  confirmedAt           DateTime?

  @@index([dossierId])
  @@index([rechercheAnnuaireId])
  @@index([status])
}

// Discussion directe, sans dossier.
//
// La messagerie etait entierement accrochee a un dossier : un praticien tout
// juste recrute, a qui rien n'est encore affecte, n'apparaissait donc nulle
// part et personne ne pouvait lui ecrire. La coordination est le pivot : elle
// ouvre une discussion avec un specialiste ou un medecin traitant, qui peut
// repondre. Les praticiens ne s'ecrivent pas entre eux.
//
// Exactement deux participants, ranges par identifiant croissant : c'est ce qui
// rend la paire unique et empeche deux fils paralleles entre les deux memes
// comptes.
model Conversation {
  id String @id @default(uuid())

  participantAId String
  participantA   User   @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User   @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Cascade)

  messages Message[]

  creeParId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id        String   @id @default(uuid())
  // Un message appartient soit a un dossier, soit a une discussion directe.
  // Jamais aux deux, jamais a aucun des deux.
  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("MessageSender", fields: [senderId], references: [id])
  // Vide quand le message ne porte qu'une pièce jointe.
  body           String
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([dossierId])
  @@index([conversationId])
}

model Rapport {
  id            String      @id @default(uuid())
  dossierId     String      @unique
  dossier       Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  specialisteId String
  specialiste   Specialiste @relation(fields: [specialisteId], references: [id])

  synthese              String?
  diagnostic            String?
  optionsTherapeutiques String?
  status                RapportStatus @default(BROUILLON)
  pdfStorageKey         String?

  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  validatedAt DateTime?

  @@index([dossierId])
}

model ProfessionalDocument {
  id         String                   @id @default(uuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ProfessionalDocumentType
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime                 @default(now())

  @@index([userId])
}

// CDC 11 : le numero de dossier est un compteur, pas un tirage aleatoire.
// Une ligne par cle (ex. "DOSSIER-2026"), incrementee atomiquement en base.
model SequenceCompteur {
  cle    String @id
  valeur Int    @default(0)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  dossierId  String?
  dossier    Dossier? @relation(fields: [dossierId], references: [id])
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([dossierId])
}

model Notification {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel String   @default("EMAIL")
  type    String
  payload Json?
  status  String   @default("SENT")
  sentAt  DateTime @default(now())

  // Set when the recipient opens the notification in the app. Null means unread,
  // which is what the bell badge counts.
  readAt DateTime?

  // Where the notification points to. Nullable because account-level events
  // (email verification, password reset) are not attached to any dossier.
  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
}

// Commentaire laissé par un patient ou un médecin traitant depuis son
// tableau de bord, affiché dans la section témoignages de l'accueil public
// une fois modéré. Jamais publié automatiquement (CDC §43 : « être prudent
// avec la notation publique ») - un admin doit approuver ou rejeter.
model Temoignage {
  id         String @id @default(uuid())
  userId     String
  user       User   @relation("TemoignageAuteur", fields: [userId], references: [id], onDelete: Cascade)
  // Capturé au moment de l'écriture : si le rôle du compte change plus tard,
  // le témoignage publié reste correctement attribué ("Patient" / "Médecin
  // traitant") sans avoir à rejouer une jointure incertaine.
  roleAuteur String
  texte      String
  note       Int?

  statut     TemoignageStatut @default(EN_ATTENTE)
  motifRejet String?
  moderePar  String?
  moderateur User?            @relation("TemoignageModerateur", fields: [moderePar], references: [id])
  modereLe   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([statut])
}

// Un specialiste qui declare un conflit d'interets ne doit plus etre propose sur
// CE dossier. Sans cette trace, le moteur d'affectation le reclasserait en tete
// au tour suivant - il coche toujours les memes criteres - et le coordinateur se
// verrait reproposer l'expert qui vient de se recuser.
//
// La recusation vaut pour un dossier, pas pour l'expert en general : le meme
// specialiste reste parfaitement affectable ailleurs.
model RecusationSpecialiste {
  id            String      @id @default(uuid())
  dossierId     String
  dossier       Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  specialisteId String
  specialiste   Specialiste @relation(fields: [specialisteId], references: [id], onDelete: Cascade)
  // Motif libre saisi par le specialiste. Conserve : c'est ce qui distingue une
  // recusation deontologique d'un simple refus pour charge de travail, et le
  // coordinateur doit pouvoir en rendre compte.
  motif         String
  createdAt     DateTime    @default(now())

  @@unique([dossierId, specialisteId])
  @@index([dossierId])
}

// Ce que la plateforme doit au spécialiste pour un avis rendu.
//
// Créé à la transmission du rapport - c'est là que l'avis est gagné - à partir
// de ce que le demandeur a réellement payé. Le montant brut est en XAF (devise
// d'encaissement), la commission de la plateforme en est retirée, et le net est
// converti dans la devise du spécialiste au taux du jour.
//
// Tout est figé sur la ligne : taux de commission, taux de change, devise. Un
// relevé qui recalculerait ces valeurs à la volée changerait de montant chaque
// fois qu'un réglage bouge, et un spécialiste payé en janvier ne doit pas voir
// son relevé de janvier changer en mars.
model Honoraire {
  id            String      @id @default(uuid())
  dossierId     String
  dossier       Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  specialisteId String
  specialiste   Specialiste @relation(fields: [specialisteId], references: [id])

  // Ce que le demandeur a payé, dans la devise d'encaissement.
  montantBrut      Decimal @db.Decimal(12, 2)
  deviseBrut       String  @default("XAF")
  // Part de la plateforme, figée au moment du calcul.
  tauxCommission   Decimal @db.Decimal(5, 2)
  commission       Decimal @db.Decimal(12, 2)
  // Ce qui revient au spécialiste, avant puis après conversion.
  montantNet       Decimal @db.Decimal(12, 2)
  deviseNet        String
  tauxChange       Decimal @db.Decimal(12, 6)
  montantNetDevise Decimal @db.Decimal(12, 2)

  statut               HonoraireStatut @default(A_REVERSER)
  // FAPSHI (Mobile Money, Cameroun) ou VIREMENT (SEPA, manuel) selon la devise.
  canal                String
  // Identifiant du décaissement Fapshi, ou référence du virement saisie à la main.
  referenceReversement String?
  reverseLe            DateTime?
  reversePar           String?
  motifEchec           String?

  createdAt DateTime @default(now())

  // Un seul honoraire par dossier : un avis n'est payé qu'une fois.
  @@unique([dossierId])
  @@index([specialisteId])
  @@index([statut])
}

// Candidature d'un praticien, remplie en ligne sur un formulaire public à
// l'invitation du comité scientifique. Aucun compte n'existe à ce stade : c'est
// la coordination qui en crée un, à partir de ces données, une fois la
// candidature acceptée par le comité.
model Candidature {
  id     String            @id @default(uuid())
  type   CandidatureType
  statut CandidatureStatut @default(EN_ATTENTE)

  // Identité et contact
  fullName String
  email    String
  phone    String?
  // Photo d'identité professionnelle, déposée avec le formulaire. Stockée
  // comme les avatars, servie par un point d'entrée dédié.
  photoKey String
  // CV au format PDF. Facultatif : le comité peut juger sur la présentation
  // seule, et exiger un fichier ferait abandonner des candidatures en route.
  cvKey    String?

  // Profil professionnel — les mêmes champs que Specialiste / MedecinLocal,
  // pour que la création du compte soit une recopie et non une ressaisie.
  specialite    String
  etablissement String?
  pays          String?
  ville         String?
  langues       String?
  numeroOrdre   String?

  // Structure d'exercice du medecin traitant, avec de quoi la joindre : le
  // comite verifie l'exercice reel en appelant l'etablissement, et un nom seul
  // ne permet pas de le faire. Nul pour un specialiste international.
  typeStructure TypeStructure?
  nomClinique   String?
  telClinique   String?
  emailClinique String?
  nomHopital    String?
  telHopital    String?
  emailHopital  String?
  // Diplômes, parcours, motivations : ce que le comité lit pour décider.
  presentation  String

  // Décision du comité
  motifRefus  String?
  decideParId String?
  decideLe    DateTime?

  // Compte créé par la coordination à partir de cette candidature.
  compteUserId String?   @unique
  compteCreeLe DateTime?

  createdAt DateTime @default(now())

  @@index([statut])
  @@index([email])
}

// Spécialités proposées dans les listes déroulantes.
//
// En base plutôt qu'en dur dans le code : la coordination doit pouvoir en
// ajouter sans redéploiement. Deux drapeaux plutôt qu'une catégorie unique —
// « Cardiologie » vaut pour les deux formulaires, « Médecine générale » n'a de
// sens que pour un médecin traitant.
//
// On désactive plutôt que de supprimer : une spécialité retirée de la liste
// reste portée par les praticiens déjà enregistrés, et son libellé doit rester
// lisible partout où il a été recopié.
model Specialite {
  id              String  @id @default(uuid())
  nom             String  @unique
  pourSpecialiste Boolean @default(true)
  pourMedecin     Boolean @default(false)
  actif           Boolean @default(true)

  creeParId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif])
}
